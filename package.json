{
  "name": "upnext-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "mock": "prism mock upnext-openapi.yaml -p 4011",
    "gen:api": "openapi-typescript upnext-openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@reduxjs/toolkit": "2.13.0",
    "clsx": "2.1.1",
    "formik": "2.4.9",
    "lucide-react": "0.475.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4",
    "redux-persist": "6.0.0",
    "tailwind-merge": "3.7.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
